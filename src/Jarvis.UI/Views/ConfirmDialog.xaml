<Window x:Class="Jarvis.UI.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jarvis — Authorization Required"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Style="{StaticResource JarvisWindow}">
    <Border BorderBrush="{StaticResource Gold}" BorderThickness="1" Padding="24">
        <StackPanel>
            <TextBlock Text="⚠ AUTHORIZATION REQUIRED" Style="{StaticResource DisplayText}"
                       Foreground="{StaticResource Gold}" FontSize="16" Margin="0,0,0,4"/>
            <TextBlock x:Name="TitleTextBlock" TextWrapping="Wrap" FontSize="14"
                       Foreground="{StaticResource TextPrimary}" Margin="0,8,0,12"/>
            <Border Background="{StaticResource BgPanelAccent}" BorderBrush="{StaticResource ArcCyanDim}"
                    BorderThickness="1" Padding="12" MaxHeight="240">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="DetailsTextBlock" TextWrapping="Wrap" FontFamily="{StaticResource BodyFont}"
                               FontSize="12" Foreground="{StaticResource TextMuted}"/>
                </ScrollViewer>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="DENY" Style="{StaticResource HudButton}" Width="120" Height="40"
                        Margin="0,0,12,0" Click="OnDeny"/>
                <Button Content="AUTHORIZE ▸" Style="{StaticResource HudButton}" Width="140" Height="40"
                        Click="OnAuthorize"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
