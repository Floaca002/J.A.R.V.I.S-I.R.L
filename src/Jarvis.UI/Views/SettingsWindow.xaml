<Window x:Class="Jarvis.UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="J.A.R.V.I.S — Settings"
        Width="560" Height="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Style="{StaticResource JarvisWindow}">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,14,0,4"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource HudTextBox}"/>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{StaticResource BgPanelAccent}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{StaticResource ArcCyan}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ArcCyanDim}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource BgPanelAccent}"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="{StaticResource ArcCyanDim}"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="◤ SETTINGS" Style="{StaticResource DisplayText}" FontSize="20" Margin="0,0,0,10"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="AI PROVIDER" Style="{StaticResource DisplayText}" FontSize="13" Margin="0,10,0,0"/>

                <TextBlock Text="Default provider" Style="{StaticResource Label}"/>
                <ComboBox x:Name="ProviderCombo" Height="36">
                    <ComboBoxItem Content="Groq"/>
                    <ComboBoxItem Content="Ollama"/>
                    <ComboBoxItem Content="Anthropic"/>
                </ComboBox>

                <TextBlock Text="Groq API key" Style="{StaticResource Label}"/>
                <PasswordBox x:Name="GroqKeyBox" Height="36"/>

                <TextBlock Text="Groq model" Style="{StaticResource Label}"/>
                <TextBox x:Name="GroqModelBox" Height="36"/>

                <TextBlock Text="Ollama model" Style="{StaticResource Label}"/>
                <TextBox x:Name="OllamaModelBox" Height="36"/>

                <TextBlock Text="Claude (Anthropic) API key — separate from a claude.ai subscription, billed per token from console.anthropic.com" Style="{StaticResource Label}" TextWrapping="Wrap"/>
                <PasswordBox x:Name="AnthropicKeyBox" Height="36"/>

                <TextBlock Text="Claude model" Style="{StaticResource Label}"/>
                <TextBox x:Name="AnthropicModelBox" Height="36"/>

                <TextBlock Text="VISION" Style="{StaticResource DisplayText}" FontSize="13" Margin="0,24,0,0"/>
                <CheckBox x:Name="VisionAttachScreenBox" Content="Let Jarvis see your screen (attaches a fresh screenshot to every message)"/>
                <TextBlock Text="Only Anthropic (Claude) currently understands images. This uses more input tokens on every single turn — it costs more per message when it's on."
                           TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,6,0,0"/>

                <TextBlock Text="VOICE" Style="{StaticResource DisplayText}" FontSize="13" Margin="0,24,0,0"/>
                <CheckBox x:Name="VoiceEnabledBox" Content="Enable voice (TTS/STT)"/>

                <TextBlock Text="Wake word" Style="{StaticResource Label}"/>
                <TextBox x:Name="WakeWordBox" Height="36"/>

                <TextBlock Text="Voice (installed on this PC)" Style="{StaticResource Label}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="VoiceNameCombo" Grid.Column="0" Height="36"/>
                    <Button Grid.Column="1" Content="▶ PREVIEW" Style="{StaticResource HudButton}" Width="120" Height="36"
                            Margin="12,0,0,0" Click="OnPreviewVoice"/>
                </Grid>
                <TextBlock Text="For a more movie-accurate sound, install a Windows &quot;Natural&quot; voice (e.g. Ryan, Guy) via Settings → Time &amp; language → Speech → Add voices, then pick it here."
                           TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,6,0,0"/>

                <TextBlock Text="SECURITY" Style="{StaticResource DisplayText}" FontSize="13" Margin="0,24,0,0"/>
                <CheckBox x:Name="ConfirmCommandsBox" Content="Require confirmation for shell commands &amp; self-upgrades"/>
                <CheckBox x:Name="ConfirmWritesBox" Content="Require confirmation for file writes &amp; deletes"/>
                <CheckBox x:Name="AllowSelfUpgradeBox" Content="Allow self-upgrade (upgrade_self tool)"/>

                <TextBlock Text="GITHUB (optional — for check_for_updates)" Style="{StaticResource DisplayText}" FontSize="13" Margin="0,24,0,0"/>
                <TextBlock Text="Repo (owner/name)" Style="{StaticResource Label}"/>
                <TextBox x:Name="GitHubRepoBox" Height="36"/>

                <TextBlock Text="Token" Style="{StaticResource Label}"/>
                <PasswordBox x:Name="GitHubTokenBox" Height="36"/>

                <TextBlock Text="Changes are saved to %AppData%\JarvisIRL\secrets.json and take effect after restarting Jarvis."
                           TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,20,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="CANCEL" Style="{StaticResource HudButton}" Width="120" Height="40"
                    Margin="0,0,12,0" Click="OnCancel"/>
            <Button Content="SAVE ▸" Style="{StaticResource HudButton}" Width="140" Height="40" Click="OnSave"/>
        </StackPanel>
    </Grid>
</Window>
